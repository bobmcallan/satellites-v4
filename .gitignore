# Claude Code per-machine settings (contains satellites hook token).
# Whole directory is per-machine — never commit any of its contents.
.claude/

# Local .env files (gitignored at any depth). Use README "Server
# configuration" for the repo-root variables and tests/.env.example
# for the test-only whitelist.
.env
tests/.env

# Local TOML config (use scripts/satellites.example.toml as the committed
# template; copy to scripts/satellites.toml and customise — story_b7b705dd).
scripts/satellites.toml

# Go build output
/satellites
/satellites-server
/satellites-agent
/satellites-client
/bin/
*.exe
*.test
*.out
*.prof

# satellites-agent local log file written by arbor when run via
# scripts/run-agent.sh in the repo root.
.satellites-agent.log

# sty_51571015: agent_dispatch creates a per-task worktree under
# .satellites-agents/<task_id>. Operators clean these via
# `git worktree remove` once the dispatched branch lands.
.satellites-agents/

# Dependencies
/vendor/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
